generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

model Target {
  id            String         @id @default(cuid())
  domain        String         @unique
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  scanJobs      ScanJob[]      @relation("TargetScanJobs")
  projectDetail ProjectDetail?

  @@map("targets")
}

model ProjectDetail {
  id          String    @id @default(cuid())
  projectId   String    @unique @map("project_id")
  title       String?
  description String?
  module      String?
  status      String?
  riskScore   Int?      @map("risk_score")
  summary     Json?
  lastScanAt  DateTime? @map("last_scan_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  project     Target    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_details")
}

model ScanJob {
  scanId          String          @id @map("scan_id")
  targetDomain    String          @map("target_domain")
  status          String
  startedAt       DateTime?       @map("started_at")
  endedAt         DateTime?       @map("ended_at")
  priorityScore   Int             @default(0) @map("priority_score")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  liveHosts       LiveHost[]
  vulnerabilities Vulnerability[]
  target          Target?         @relation("TargetScanJobs", fields: [targetDomain], references: [domain], onUpdate: Cascade)

  @@index([targetDomain])
  @@map("scan_jobs")
}

model LiveHost {
  id         Int      @id @default(autoincrement())
  scanId     String   @map("scan_id")
  url        String?
  statusCode Int?     @map("status_code")
  title      String?
  tech       String?  @db.Text
  method     String?
  raw        String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  scanJob ScanJob @relation(fields: [scanId], references: [scanId], onDelete: Cascade, onUpdate: Cascade)

  @@index([scanId])
  @@map("live_hosts")
}

model Vulnerability {
  id         Int      @id @default(autoincrement())
  scanId     String   @map("scan_id")
  source     String
  templateId String?  @map("template_id")
  host       String?
  severity   String?
  matched    String?  @db.Text
  endpoint   String?
  statusCode Int?     @map("status_code")
  length     Int?
  raw        String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  scanJob ScanJob @relation(fields: [scanId], references: [scanId], onDelete: Cascade, onUpdate: Cascade)

  @@index([scanId])
  @@index([source])
  @@index([severity])
  @@map("vulnerabilities")
}

model AdminUser {
  id               String    @id @default(cuid())
  authUserId       String?   @unique @map("auth_user_id")
  name             String?
  email            String    @unique
  role             String    @default("USER")
  packageTier      String    @default("FREE") @map("package_tier")
  status           String    @default("ACTIVE")
  dailyLimit       Int       @default(5) @map("daily_limit")
  scansToday       Int       @default(0) @map("scans_today")
  telegramConnected Boolean  @default(false) @map("telegram_connected")
  planExpiresAt    DateTime? @map("plan_expires_at")
  oauthProvider    String?   @map("oauth_provider")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("admin_users")
}

model RedeemCode {
  id                  String                 @id @default(cuid())
  code                String                 @unique
  packageTier         String                 @map("package_tier")
  durationLabel       String                 @map("duration_label")
  durationDays        Int?                   @map("duration_days")
  maxUses             Int                    @default(1) @map("max_uses")
  usedCount           Int                    @default(0) @map("used_count")
  status              String                 @default("UNUSED")
  activatedBy         String?                @map("activated_by")
  createdByAuthUserId String?                @map("created_by_auth_user_id")
  createdByEmail      String?                @map("created_by_email")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  redemptions         RedeemCodeRedemption[]

  @@map("redeem_codes")
}

model RedeemCodeRedemption {
  id           String     @id @default(cuid())
  redeemCodeId String     @map("redeem_code_id")
  userAuthId   String     @map("user_auth_id")
  userEmail    String     @map("user_email")
  createdAt    DateTime   @default(now()) @map("created_at")
  redeemCode   RedeemCode @relation(fields: [redeemCodeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([redeemCodeId, userEmail])
  @@index([userAuthId])
  @@index([userEmail])
  @@map("redeem_code_redemptions")
}

model AdminAction {
  id                 String   @id @default(cuid())
  adminAuthUserId    String?  @map("admin_auth_user_id")
  targetAdminUserId  String?  @map("target_admin_user_id")
  action             String
  detail             Json?    
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("admin_actions")
}

model OutgoingEmail {
  id        String   @id @default(cuid())
  to        String   @map("to")
  subject   String
  bodyText  String?  @map("body_text")
  bodyHtml  String?  @map("body_html")
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("outgoing_emails")
}