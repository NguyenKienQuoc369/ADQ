# File: Dockerfile.backend
FROM python:3.11-slim

# Cài đặt các gói hệ thống cơ bản và Golang
RUN apt-get update && apt-get install -y \
    wget curl git gcc make libpcap-dev \
    golang-go netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Thiết lập đường dẫn cho Go binaries
ENV GOPATH=/root/go
ENV PATH=$PATH:/root/go/bin

# Cài đặt các công cụ bảo mật lõi
RUN go install -v github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest && \
    go install -v github.com/projectdiscovery/httpx/cmd/httpx@latest && \
    go install -v github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest && \
    go install -v github.com/ffuf/ffuf/v2@latest

# Thiết lập thư mục làm việc cho Python
WORKDIR /app

# Copy dependency và cài đặt thư viện Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy toàn bộ mã nguồn backend vào container
COPY . .

# Mặc định (Sẽ bị ghi đè bởi docker-compose)
CMD ["python3", "api_server.py"]
