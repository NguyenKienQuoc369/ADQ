{
  "manifest_version": "2.0.0",
  "target_name": "OWASP Juice Shop",
  "target_version": "v17.1.1",
  "base_url": "http://127.0.0.1:3000",
  "coverage_scope": "Blackbox DAST (SQLi, XSS, Secrets, Misconfigurations, Endpoints, Headers, Ports)",
  "entries": [
    {
      "id": "JS-SQLI-01",
      "expected": "POSITIVE",
      "category": "SQL Injection",
      "endpoint": "/rest/products/search",
      "parameter": "q",
      "method": "GET",
      "cwe": "CWE-89",
      "cve": null,
      "severity_reference": "HIGH",
      "source_of_ground_truth": "OWASP Juice Shop Official Challenge: Restful SQLi",
      "notes": "Union-based SQL injection via product search query string parameter q"
    },
    {
      "id": "JS-SQLI-02",
      "expected": "POSITIVE",
      "category": "SQL Injection",
      "endpoint": "/rest/user/login",
      "parameter": "email",
      "method": "POST",
      "cwe": "CWE-89",
      "cve": null,
      "severity_reference": "CRITICAL",
      "source_of_ground_truth": "OWASP Juice Shop Official Challenge: Login Admin",
      "notes": "Classic SQLi in login email field bypassing authentication"
    },
    {
      "id": "JS-XSS-01",
      "expected": "POSITIVE",
      "category": "Cross-Site Scripting",
      "endpoint": "/#/",
      "parameter": "q",
      "method": "GET",
      "cwe": "CWE-79",
      "cve": null,
      "severity_reference": "MEDIUM",
      "source_of_ground_truth": "OWASP Juice Shop Official Challenge: DOM XSS",
      "notes": "Reflected DOM XSS in search query bar"
    },
    {
      "id": "JS-XSS-02",
      "expected": "POSITIVE",
      "category": "Cross-Site Scripting",
      "endpoint": "/api/Feedbacks/",
      "parameter": "comment",
      "method": "POST",
      "cwe": "CWE-79",
      "cve": null,
      "severity_reference": "HIGH",
      "source_of_ground_truth": "OWASP Juice Shop Official Challenge: Persisted XSS",
      "notes": "Stored XSS in customer feedback comment field"
    },
    {
      "id": "JS-SECRET-01",
      "expected": "POSITIVE",
      "category": "Exposed Secrets",
      "endpoint": "/main.js",
      "parameter": null,
      "resource": "main.js",
      "secret_type": "jwt_token",
      "cwe": "CWE-526",
      "cve": null,
      "severity_reference": "MEDIUM",
      "source_of_ground_truth": "Juice Shop Client Bundle Inspection",
      "notes": "Hardcoded demo JWT signature/tokens in Angular client bundle"
    },
    {
      "id": "JS-MISCONFIG-01",
      "expected": "POSITIVE",
      "category": "Security Misconfiguration",
      "endpoint": "/ftp",
      "parameter": null,
      "method": "GET",
      "cwe": "CWE-548",
      "cve": null,
      "severity_reference": "MEDIUM",
      "source_of_ground_truth": "OWASP Juice Shop Challenge: Confidential Document",
      "notes": "Unauthenticated public directory listing on /ftp endpoint"
    },
    {
      "id": "JS-MISCONFIG-02",
      "expected": "POSITIVE",
      "category": "Security Misconfiguration",
      "endpoint": "/",
      "parameter": null,
      "method": "GET",
      "cwe": "CWE-693",
      "cve": null,
      "severity_reference": "LOW",
      "source_of_ground_truth": "HTTP Response Headers Audit",
      "notes": "Missing Content-Security-Policy & X-Content-Type-Options security headers"
    },
    {
      "id": "JS-MISCONFIG-03",
      "expected": "POSITIVE",
      "category": "Security Misconfiguration",
      "endpoint": "/rest/user/login",
      "parameter": null,
      "method": "OPTIONS",
      "cwe": "CWE-942",
      "cve": null,
      "severity_reference": "MEDIUM",
      "source_of_ground_truth": "CORS Policy Analysis",
      "notes": "Permissive Access-Control-Allow-Origin with credentials on login endpoint"
    },
    {
      "id": "JS-ENDPOINT-01",
      "expected": "POSITIVE",
      "category": "Sensitive Endpoint Exposure",
      "endpoint": "/api-docs",
      "parameter": null,
      "method": "GET",
      "cwe": "CWE-200",
      "cve": null,
      "severity_reference": "LOW",
      "source_of_ground_truth": "Swagger UI Endpoint Specification",
      "notes": "Publicly exposed interactive Swagger / OpenAPI documentation"
    },
    {
      "id": "JS-ENDPOINT-02",
      "expected": "POSITIVE",
      "category": "Sensitive Endpoint Exposure",
      "endpoint": "/metrics",
      "parameter": null,
      "method": "GET",
      "cwe": "CWE-200",
      "cve": null,
      "severity_reference": "LOW",
      "source_of_ground_truth": "Prometheus Metrics Exposure Spec",
      "notes": "Public Prometheus server telemetry and process metrics"
    },
    {
      "id": "JS-PORT-01",
      "expected": "POSITIVE",
      "category": "Open Service",
      "host": "127.0.0.1",
      "port": 3000,
      "severity_reference": "INFO",
      "source_of_ground_truth": "Docker Container Port Binding",
      "notes": "Primary Node.js HTTP application service listener"
    },
    {
      "id": "JS-NEG-01",
      "expected": "NEGATIVE",
      "category": "SQL Injection",
      "endpoint": "/api/Quantitys",
      "parameter": "id",
      "method": "GET",
      "source_of_ground_truth": "Sequelize ORM Parameterized Query Verification",
      "notes": "Negative Control: ORM-protected quantity lookup does not allow SQLi"
    },
    {
      "id": "JS-NEG-02",
      "expected": "NEGATIVE",
      "category": "Cross-Site Scripting",
      "endpoint": "/rest/languages",
      "parameter": null,
      "method": "GET",
      "source_of_ground_truth": "Static JSON Endpoint Verification",
      "notes": "Negative Control: Static language list returns static JSON without reflection"
    },
    {
      "id": "JS-NEG-03",
      "expected": "NEGATIVE",
      "category": "Exposed Secrets",
      "endpoint": "/assets/public/favicon_js.ico",
      "parameter": null,
      "resource": "favicon_js.ico",
      "source_of_ground_truth": "Static Binary Asset Audit",
      "notes": "Negative Control: Binary icon asset contains no plaintext API keys or tokens"
    },
    {
      "id": "JS-NEG-04",
      "expected": "NEGATIVE",
      "category": "Open Service",
      "host": "127.0.0.1",
      "port": 3306,
      "source_of_ground_truth": "Architecture Spec: SQLite only",
      "notes": "Negative Control: MySQL service port 3306 is not open or running"
    }
  ]
}
