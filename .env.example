# =================================================================
# Cấu hình Telegram Notifications
# =================================================================
# CẢNH BÁO BẢO MẬT: KHÔNG bao giờ commit file .env vào Git!
# Luôn thêm .env vào .gitignore
#
# Hướng dẫn:
# 1. Copy file này thành .env:
#    $ cp .env.example .env
#
# 2. Điền thông tin của bạn:
#    $ nano .env  (hoặc editor yêu thích)
#
# 3. Thêm .env vào .gitignore (nếu chưa):
#    $ echo ".env" >> .gitignore
#    $ echo ".env.local" >> .gitignore
#    $ git rm --cached .env 2>/dev/null || true
#
# 4. Chạy script:
#    $ source .env
#    $ python quoc_omni.py your_target.com --ctf-mode
#

# Token của Telegram Bot
# Lấy từ BotFather: @BotFather trên Telegram
# Format: 123456789:ABCdefGHIjklmnopQRSTuvwxyz
TELEGRAM_TOKEN=8941326998:AAFu2GaZu_Sa7P5BkLYBHv5ipt0EYT0Jqb0
# Chat ID để gửi thông báo
# Lấy bằng cách:
# 1. Nhắn tin cho bot của bạn
# 2. Truy cập: https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. Tìm "chat": {"id": 123456789}
# Format: số nguyên dương (ví dụ: 123456789)
TELEGRAM_CHAT_ID=7122829798
TELEGRAM_API_TIMEOUT=20
TELEGRAM_POLL_TIMEOUT=50
TELEGRAM_POLL_INTERVAL=0.5
TELEGRAM_QUEUE_PATH=/home/sisiniki123/ADQ/runtime/telegram_approvals.jsonl
TELEGRAM_QUEUE_CURSOR_PATH=/home/sisiniki123/ADQ/runtime/telegram_approvals.cursor

# =================================================================
# Cấu hình công cụ (tùy chọn)
# =================================================================

# Đường dẫn đến wordlist FFuf
# Mặc định: /usr/share/seclists/Discovery/Web-Content/common.txt
WORDLIST_PATH=/usr/share/seclists/Discovery/Web-Content/common.txt

# =================================================================
# Cấu hình Prisma + Supabase (Giai đoạn 1 DB Schema)
# =================================================================
# Prisma Transaction Pooler (cổng 6543)
DATABASE_URL=
# Prisma direct connection (cổng 5432)
DIRECT_URL=

# =================================================================
# Cấu hình ADQ Security Copilot (Google Gemini API)
# =================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.5-flash

# =================================================================
# Cấu hình AI Agent (Giai đoạn 2)
# =================================================================
# Bật AI phân tích trong worker
AI_ENABLED=false
# Endpoint OpenAI-compatible chat completions, ví dụ:
# https://api.openai.com/v1/chat/completions
AI_API_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30

# =================================================================
# GHI CHÚ BẢO MẬT
# =================================================================
# 
# ✅ LÀM:
#   - Lưu credentials trong file .env cục bộ
#   - Thêm .env vào .gitignore
#   - Sử dụng: export TELEGRAM_TOKEN=$(grep '^TELEGRAM_TOKEN=' .env | cut -d'=' -f2)
#   - Kiểm tra thường xuyên: git log -p --all -S TELEGRAM_TOKEN
#
# ❌ KHÔNG LÀM:
#   - Không commit .env lên Git
#   - Không truyền token qua command-line: python script.py --token "abc..."
#   - Không chia sẻ credentials qua email/chat/Discord
#   - Không viết token trong code comments hoặc README
#
# 🔐 NẾU BỊ LEAK:
#   - Xóa ngay token trên BotFather
#   - Tạo token mới
#   - Chạy: git filter-branch để xóa khỏi Git history
#   - Hoặc sử dụng: git-secrets, TruffleHog để scan
#
