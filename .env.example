# =================================================================
# Cấu hình ADQ Security Core
# =================================================================
# CẢNH BÁO BẢO MẬT: KHÔNG bao giờ commit file .env vào Git!
# Luôn thêm .env vào .gitignore
#
# Hướng dẫn:
# 1. Copy file này thành .env:
#    $ cp .env.example .env
#
# 2. Điền thông tin của bạn:
#    $ nano .env  (hoặc editor yêu thích)
#
# 3. Thêm .env vào .gitignore (nếu chưa):
#    $ echo ".env" >> .gitignore
#    $ echo ".env.local" >> .gitignore
#    $ git rm --cached .env 2>/dev/null || true
#
# 4. Chạy script:
#    $ python adq_cli.py
#

# =================================================================
# Cấu hình công cụ (tùy chọn)
# =================================================================

# Đường dẫn đến wordlist FFuf
# Mặc định: /usr/share/seclists/Discovery/Web-Content/common.txt
WORDLIST_PATH=/usr/share/seclists/Discovery/Web-Content/common.txt

# =================================================================
# Cấu hình ADQ Security Core & API Server
# =================================================================
PORT=8000
DATABASE_URL=postgresql://postgres:password@localhost:5432/adq_db
DIRECT_URL=postgresql://postgres:password@localhost:5432/adq_db
REDIS_URL=redis://localhost:6379/0

# =================================================================
# Supabase & JWT Auth Configuration
# =================================================================
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
FRONTEND_URL=http://localhost:3000

# =================================================================
# Frontend Environment Variables (Next.js)
# =================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# =================================================================
# Cấu hình ADQ Security Copilot (Google Gemini API)
# =================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.5-flash

# =================================================================
# Cấu hình AI Agent (Giai đoạn 2)
# =================================================================
# Bật AI phân tích trong worker
AI_ENABLED=false
# Endpoint OpenAI-compatible chat completions, ví dụ:
# https://api.openai.com/v1/chat/completions
AI_API_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30

# =================================================================
# GHI CHÚ BẢO MẬT
# =================================================================
# 
# ✅ LÀM:
#   - Lưu credentials trong file .env cục bộ
#   - Thêm .env vào .gitignore
#
# ❌ KHÔNG LÀM:
#   - Không commit .env lên Git
#   - Không truyền API key/secret qua command-line: python script.py --token "abc..."
#   - Không chia sẻ credentials qua email/chat/Discord
#   - Không viết token trong code comments hoặc README
