adq.io.vn {
    handle /api/health {
        reverse_proxy api-server:8000
    }
    handle /api/scan/* {
        reverse_proxy api-server:8000
    }
    handle /api/scan {
        reverse_proxy api-server:8000
    }
    handle /api/verification/* {
        reverse_proxy api-server:8000
    }
    handle /api/stress/* {
        reverse_proxy api-server:8000
    }
    handle /api/apk-audit/* {
        reverse_proxy api-server:8000
    }
    handle /api/maintenance/* {
        reverse_proxy api-server:8000
    }
    handle /api/copilot/* {
        reverse_proxy api-server:8000
    }
    handle /api/c2/* {
        reverse_proxy api-server:8000
    }
    handle /api/ctem/* {
        reverse_proxy api-server:8000
    }
    handle /api/graph/* {
        reverse_proxy api-server:8000
    }
    handle /api/grid/* {
        reverse_proxy api-server:8000
    }
    handle /api/oast/* {
        reverse_proxy api-server:8000
    }
    handle {
        reverse_proxy web-dashboard:3000
    }
}

www.adq.io.vn {
    redir https://adq.io.vn{uri} permanent
}

api.adq.io.vn {
    reverse_proxy api-server:8000
}

