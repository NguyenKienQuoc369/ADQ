# ====================================================================
# ADQ ENTERPRISE DAST/ASM PLATFORM - PRODUCTION ENVIRONMENT VARIABLES
# ====================================================================

# ====================================================================
# 1. BACKEND VPS SECRETS (Saved in /home/user/ADQ/.env on VPS)
# ====================================================================

# Database Credentials (Supabase PostgreSQL Transaction Pooler)
# Replace with your actual Supabase Transaction Pooler URL (Port 6543, pgbouncer=true)
DATABASE_URL=postgresql://postgres.your_supabase_ref:YourPassword@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true

# Redis Message Broker
REDIS_URL=redis://adq_redis:6379/0

# OAST Interaction Server Config
OAST_SERVER_URL=http://YOUR_VPS_PUBLIC_IP:8888
OAST_PORT=8888

# Telegram Bot HITL (Human-in-the-Loop) Integration
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-100123456789

# ADQ Security Copilot (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.5-flash

# Recon & Intelligence API Keys (Optional)
SHODAN_API_KEY=your_shodan_api_key_here
GITHUB_TOKEN=ghp_your_github_token_here
SECURITYTRAILS_API_KEY=your_securitytrails_key_here


# ====================================================================
# 2. VERCEL FRONTEND SECRETS (Configured in Vercel Dashboard Settings)
# ====================================================================
# Add these in Vercel -> Project Settings -> Environment Variables:

# NEXT_PUBLIC_API_URL: Public URL of your FastAPI Backend on VPS / Cloudflare
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# DATABASE_URL: Supabase Transaction Pooler URL (Port 6543 with pgbouncer=true)
# DATABASE_URL="postgresql://postgres.your_supabase_ref:YourPassword@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# DIRECT_URL: Supabase Direct Connection URL (Port 5432 for migrations/prisma db push)
# DIRECT_URL="postgresql://postgres.your_supabase_ref:YourPassword@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require"
